<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.liino.qwen-tts-daemon</string>
    <!-- daemon รันที่ nice 0 ปกติ (ไม่ใช้ nice wrapper)
         หมายเหตุ: nice ค่าลบ (เช่น -5, ให้ daemon สำคัญกว่า process อื่น)
         ต้องสิทธิ์ root — launchd user agent (~/Library/LaunchAgents) ทำไม่ได้
         ถ้าต้องการ -5 จริง ต้องย้าย plist ไป /Library/LaunchDaemons
         และรันเป็น system daemon ผ่าน sudo (sudo launchctl load /Library/LaunchDaemons/...)
         ทางเลือกแนะนำในบริบท GPU-bound: ดูหัวข้อ "Priority" ใน README -->
    <key>ProgramArguments</key>
    <array>
        <string>/Users/mungmee/Desktop/Project/Python/qwen3-tts-apple-silicon/.venv/bin/python</string>
        <string>/Users/mungmee/Desktop/Project/Python/qwen3-tts-apple-silicon/tts_daemon.py</string>
    </array>
    <!-- defense-in-depth: relative path ที่หลุดมาจะ resolve เข้า project root
         แทน / (daemon ปฏิเสธ relative out_path อยู่แล้ว — ดู handle_request) -->
    <key>WorkingDirectory</key>
    <string>/Users/mungmee/Desktop/Project/Python/qwen3-tts-apple-silicon</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/tmp/qwen_tts_daemon.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/qwen_tts_daemon.err.log</string>
</dict>
</plist>
